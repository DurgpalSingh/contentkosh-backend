DATABASE_URL="postgresql://dp:Contentkosh@2026postgres@localhost:5432/contentkosh?schema=public"
# change this to your actual database URL

# Content Upload Configuration
ALLOWED_FILE_TYPES=pdf,jpg,jpeg,png,doc,docx
MAX_PDF_SIZE_MB=10
MAX_IMAGE_SIZE_MB=5
MAX_DOC_SIZE_MB=10
UPLOAD_DIR=uploads/content
REFRESH_TOKEN_EXPIRES_IN=3600000
REFRESH_COOKIE_MAX_AGE_MS=3600000
COOKIE_SAME_SITE=none
COOKIE_SECURE=true
COOKIE_DOMAIN=.contentkosh.in
FRONTEND_URL=https://uat.contentkosh.in

# SMTP (Hostinger) — sends transactional emails (business signup / status notifications)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_NAME=ContentKosh
MAIL_FROM_EMAIL=
BUSINESS_SIGNUP_NOTIFICATION_EMAIL=