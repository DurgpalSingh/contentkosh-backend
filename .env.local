DATABASE_URL="postgresql://postgres:postgres@localhost:5432/contentkosh?schema=public"
# change this to your actual database URL

# Content Upload Configuration
ALLOWED_FILE_TYPES=pdf,jpg,jpeg,png,doc,docx
MAX_PDF_SIZE_MB=10
MAX_IMAGE_SIZE_MB=5
MAX_DOC_SIZE_MB=10
UPLOAD_DIR=uploads/content

REFRESH_TOKEN_EXPIRES_IN=3600000
REFRESH_COOKIE_MAX_AGE_MS=3600000

# Gmail API (OAuth2) — sends the new-business-signup notification email
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=
BUSINESS_SIGNUP_NOTIFICATION_EMAIL=